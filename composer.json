{
    "name": "php-io-extensions/fb",
    "type": "php-ext",
    "description": "Framebuffers for the Venusian Surface CPU renderers: five buffer kinds in C",
    "license": "MIT",
    "version": "0.8.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "fb",
        "priority": 30,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families-exclude": [
            "windows"
        ],
        "configure-options": [
            {
                "name": "enable-fb",
                "description": "Enable the fb extension",
                "needs-value": false
            }
        ]
    }
}
